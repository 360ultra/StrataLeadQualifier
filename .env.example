# Required — both free
TELEGRAM_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (optional, default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Google Sheets (optional)
SHEETS_CREDENTIALS_FILE=service_account.json
SHEET_NAME=Lead_Qualifier_Logs

# Webhook URL (optional — leave empty for free polling mode)
WEBHOOK_URL=
PORT=8080
